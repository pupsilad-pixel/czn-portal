# Пример файла переменных окружения
# Скопируйте этот файл как .env.local и заполните значения

# URL приложения
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API endpoints (для будущей интеграции)
# NEXT_PUBLIC_API_URL=https://api.czn-rt.ru
# API_SECRET_KEY=your-secret-key

# Яндекс.Карты API key (для будущей интеграции)
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY=your-api-key

# Метрики и аналитика (для будущей интеграции)
# NEXT_PUBLIC_YANDEX_METRIKA_ID=your-metrika-id
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your-ga-id
